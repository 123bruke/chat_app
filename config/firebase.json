{
    "firestore": {
        "rules": "../firestore-data/firestore.rules"
    },
    "hosting": {
        "public": "../dist",
        "ignore": [
            "../firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [{
            "source": "**",
            "destination": "/index.html"
        }]
    }
}